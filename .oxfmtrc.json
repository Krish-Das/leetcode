{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "useTabs": false,
  "tabWidth": 2,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": false,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "sortImports": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    ".next",
    "dist",
    "build",
    "packages/ui/src/styles.css",
    "**/next-env.d.ts",
    "**/convex/_generated",
    "**/*.{yaml,yml}",
    "**/*.toml",
    "**/*.{md,mdx}"
  ]
}
