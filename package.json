{
  "name": "leetcode",
  "module": "index.ts",
  "dependencies": {
    "@vitest/coverage-v8": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@type-challenges/utils": "^0.1.1",
    "@types/bun": "latest",
    "@vitest/ui": "^4.1.12",
    "typescript": "^6",
    "vitest": "^4.1.12"
  },
  "private": true,
  "scripts": {
    "fmt": "biome format --write",
    "fmt:check": "biome format",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "debug": "bun --inspect-wait=localhost:6499/debug",
    "debug:watch": "bun --watch --inspect-wait=localhost:6499/debug",
    "test:watch": "vitest",
    "test:ui": "vitest --ui --open=false",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:coverage": "vitest run --coverage --coverage.reporter=text"
  },
  "type": "module"
}
