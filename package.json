{
  "name": "leetcode",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@type-challenges/utils": "^0.1.1",
    "@types/bun": "latest",
    "@vitest/ui": "^4.1.10",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui --open=false",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:coverage": "vitest run --coverage --coverage.reporter=text"
  },
  "dependencies": {
    "@vitest/coverage-v8": "^4.1.10"
  }
}
